{
  "name": "the-descendants-of-criminals",
  "private": true,
  "version": "1.2.2",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run worldgen:sync && vite --host 127.0.0.1",
    "check": "node tools/check-types.mjs",
    "build": "npm run worldgen:sync && npm run check && vite build",
    "build:portable": "npm run worldgen:sync && node tools/build-portable.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "preview:portable": "node tools/serve.mjs dist 4173",
    "test:unit": "node tools/test-unit.mjs",
    "verify": "npm run contract:check && npm run worldgen:sync && npm run version:check && npm run research:check && npm run check && npm run test:worldgen-integration && npm run test:unit && npm run desktop:check && npm run build:portable && node tools/check-generated-package.mjs && npm run release:audit",
    "version:check": "node tools/check-version.mjs",
    "desktop": "npm run build:portable && electron .",
    "desktop:dev": "electron electron/main.cjs --dev",
    "desktop:check": "node --check electron/main.cjs && node --check electron/preload.cjs",
    "test:electron-e2e": "node tools/run-electron-path-e2e.mjs",
    "contract:check": "node tools/check-world-contract.mjs",
    "worldgen:sync": "node tools/sync-worldgen-runtime.mjs",
    "test:worldgen-integration": "npm run test:compile && node tools/verify-current-worldgen-integration.mjs",
    "test:worldgen-merge-gates": "npm run test:compile && node tools/verify-current-worldgen-integration.mjs --merge-gates-only",
    "release:audit": "node tools/audit-release-surface.mjs",
    "research:check": "node tools/check-references.mjs",
    "package:hash": "node tools/write-package-sha.mjs",
    "test:compile": "node tools/compile-test-dist.mjs",
    "audit:i1c-f3": "node tools/audit-i1c-f3-parity.mjs",
    "audit:i1c-f3-read": "node tools/audit-i1c-f3-read-switch.mjs",
    "audit:i1d-world": "node tools/audit-i1d-world-graph-parity.mjs",
    "audit:i1d-world-read": "node tools/audit-i1d2-world-read-switch.mjs",
    "audit:i1e-knowledge-persistence": "node tools/audit-i1e-knowledge-persistence.mjs",
    "audit:i1-consolidation": "node tools/audit-i1-consolidation-gate.mjs",
    "audit:i2-incidents": "node tools/audit-i2-incident-adapter.mjs",
    "audit:i2b-incidents": "node tools/audit-i2b-incident-lifecycle.mjs",
    "audit:i2c-dispatch": "node tools/audit-i2c-incident-dispatch.mjs",
    "audit:i2d-response": "node tools/audit-i2d-incident-response.mjs",
    "audit:i2e-resources": "node tools/audit-i2e-incident-resources.mjs",
    "audit:i2f-resolution": "node tools/audit-i2f-positive-resolution.mjs",
    "audit:i2g-evidence-use": "node tools/audit-i2g-evidence-resource-use.mjs",
    "audit:i2h-debriefs": "node tools/audit-i2h-response-debriefs.mjs",
    "audit:i2i-f1-ui": "node tools/audit-i2i-f1-response-ui.mjs",
    "audit:i2j-f1-focus": "node tools/audit-i2j-f1-incident-focus.mjs",
    "audit:i2k-f1-density": "node tools/audit-i2k-f1-density.mjs",
    "audit:i2k-release-gate": "node tools/audit-i2k-incident-adapter-release-gate.mjs",
    "audit:i2l-f1-facts": "node tools/audit-i2l-f1-fact-navigation.mjs",
    "audit:i2l-release-checklist": "node tools/audit-i2l-release-checklist.mjs",
    "audit:i2m-readiness": "node tools/audit-i2m-response-readiness.mjs",
    "audit:i2n-roster": "node tools/audit-i2n-response-roster.mjs",
    "audit:i2o-logistics": "node tools/audit-i2o-response-logistics.mjs",
    "audit:i2p-coordination": "node tools/audit-i2p-response-coordination.mjs",
    "audit:i2q-execution": "node tools/audit-i2q-coordination-execution.mjs",
    "audit:i2r-batch": "node tools/audit-i2r-coordination-batch.mjs",
    "audit:i2s-readback-retry": "node tools/audit-i2s-coordination-readback-retry.mjs",
    "audit:i2t-external-registry": "node tools/audit-i2t-external-receipt-registry.mjs",
    "audit:i2u-external-queue-execution": "node tools/audit-i2u-external-queue-execution.mjs",
    "audit:i2v-external-queue-batch": "node tools/audit-i2v-external-queue-batch.mjs",
    "audit:i2w-external-batch-readback-retry": "node tools/audit-i2w-external-batch-readback-retry.mjs",
    "audit:i2x-external-batch-view": "node tools/audit-i2x-external-batch-view.mjs",
    "test:long-run": "npm run test:compile && node tools/verify-long-campaign.mjs"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "vite": "8.1.5",
    "electron": "41.10.3"
  },
  "description": "WorldProvider-backed generated-world direct-play simulation; legacy Content Studio is removed.",
  "main": "electron/main.cjs"
}
